# Copy to server/.env and fill in. Never commit .env.
BOT_TOKEN=                       # from @BotFather
BOT_USERNAME=                    # without @, e.g. usapp_kosalexus_bot
WEBAPP_URL=https://usapp.kosalexus.by
WEBHOOK_SECRET=                  # random string:  openssl rand -hex 24
PORT=3100
HOST=127.0.0.1
DB_PATH=./data/us-app.db
TZ_OFFSET_HOURS=3                # Europe/Minsk
# DEV_MODE=1                     # LOCAL ONLY: lets you test in a browser with ?dev=111:Name. Never in production.
